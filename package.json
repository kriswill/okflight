{
  "name": "@kriswill/okflight",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI for maintaining OKF knowledge bundles: scaffold/index/validate/viz (self-contained 3D graph), plus a guided setup wizard",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriswill/okflight.git"
  },
  "homepage": "https://github.com/kriswill/okflight#readme",
  "keywords": [
    "okf",
    "knowledge-graph",
    "documentation",
    "cli",
    "bun"
  ],
  "bin": {
    "okflight": "bin/okf.mjs",
    "okf": "bin/okf.mjs"
  },
  "files": [
    "bin/",
    "okf.ts",
    "init.ts",
    "setup.ts",
    "bootstrap.ts",
    "lib.ts",
    "config-cli.ts",
    "vcs/",
    "scaffold.ts",
    "migrate.ts",
    "migrate-doc.ts",
    "scaffold-api.ts",
    "index-gen.ts",
    "validate.ts",
    "viz.ts",
    "viz-perf.ts",
    "layout3d.ts",
    "licenses.ts",
    "viz-app/",
    "!viz-app/**/*.test.ts",
    "!viz-app/GLStub.svelte",
    "templates/",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "dependencies": {
    "@threlte/core": "^8.5.16",
    "katex": "^0.19.1",
    "postprocessing": "^6.38.3",
    "svelte": "^5.56.4",
    "three": "~0.187.0"
  },
  "optionalDependencies": {
    "bun": "^1.4.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.16.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3"
  }
}
